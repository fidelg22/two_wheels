# Conexión a la base de datos PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@localhost:5432/NOMBRE_DB
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA_POSTGRES@localhost:5432/twowheels

# Clave secreta para las sesiones del admin (escribí cualquier texto largo y aleatorio)
SECRET_KEY=mi-clave-super-secreta-twowheels-2025

# Usuario y contraseña para entrar al panel de administración del sitio
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TU_CONTRASEÑA_ADMIN

# No tocar esto (permite que el frontend se comunique con el backend)
CORS_ORIGINS=http://localhost:5173

# Cloudinary — subida de fotos (obtener en console.cloudinary.com)
CLOUDINARY_CLOUD_NAME=TU_CLOUD_NAME
CLOUDINARY_API_KEY=TU_API_KEY
CLOUDINARY_API_SECRET=TU_API_SECRET
